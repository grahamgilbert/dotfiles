[push]
	default = current
[rerere]
	enabled = true
[core]
	precomposeunicode = true
	excludesfile = /Users/graham_gilbert/.gitignore_global
	fsmonitor = true
[user]
	name = Graham Gilbert
	email = graham.gilbert@airbnb.com
[diff]
	tool = Kaleidoscope
[difftool "Kaleidoscope"]
	cmd = ksdiff --partial-changeset --relative-path \"$MERGED\" -- \"$LOCAL\" \"$REMOTE\"
[difftool]
	prompt = false
	trustExitCode = true
[merge]
	tool = Kaleidoscope
[mergetool "Kaleidoscope"]
	cmd = ksdiff --merge --output \"$MERGED\" --base \"$BASE\" -- \"$LOCAL\" --snapshot \"$REMOTE\" --snapshot
	trustExitCode = true
[mergetool]
	prompt = false
[pull]
	rebase = false
[init]
	defaultBranch = main
[url "ssh://git@git.musta.ch/"]
    insteadOf = https://git.musta.ch/
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[feature]
	manyFiles = true
{{ if eq .chezmoi.hostname "MiniPants" -}}
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
{{ end -}}
{{ if eq .chezmoi.hostname "Thunderpants-mk-9" }}
# iapsshctl gitconfig BEGIN - DO NOT EDIT
[url "git@git.musta.ch:"]
